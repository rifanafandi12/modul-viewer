PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# WAJIB DIGANTI. Jangan salin nilai ini ke .env.
# Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server akan menolak start jika nilai ini masih placeholder.
APP_SECRET=CHANGEME_GENERATE_WITH_NODE_CRYPTO
STORAGE_PATH=./storage
TMP_PATH=./tmp